{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",           "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options",     "value": "nosniff" },
        { "key": "Referrer-Policy",            "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",         "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security",  "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": { "maxDuration": 30 }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/assets/(.*)", "dest": "/frontend/assets/$1" },
    { "src": "/favicon.svg", "dest": "/frontend/favicon.svg" },
    { "src": "/favicon-32.png", "dest": "/frontend/favicon-32.png" },
    { "src": "/favicon-16.png", "dest": "/frontend/favicon-16.png" },
    { "src": "/apple-touch-icon.png", "dest": "/frontend/apple-touch-icon.png" },
    { "src": "/icon-192.png", "dest": "/frontend/icon-192.png" },
    { "src": "/robots.txt", "dest": "/frontend/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/frontend/sitemap.xml" },
    { "src": "/privacy", "dest": "/frontend/privacy.html" },
    { "src": "/privacy.html", "dest": "/frontend/privacy.html" },
    { "src": "/404", "dest": "/frontend/404.html" },
    { "src": "/vs/typeform", "dest": "/frontend/vs-typeform.html" },
    { "src": "/vs/typeform.html", "dest": "/frontend/vs-typeform.html" },
    { "src": "/vs/jotform", "dest": "/frontend/vs-jotform.html" },
    { "src": "/vs/jotform.html", "dest": "/frontend/vs-jotform.html" },
    { "src": "/vs/google-forms", "dest": "/frontend/vs-google-forms.html" },
    { "src": "/vs/google-forms.html", "dest": "/frontend/vs-google-forms.html" },
    { "src": "/vs/tally", "dest": "/frontend/vs-tally.html" },
    { "src": "/vs/tally.html", "dest": "/frontend/vs-tally.html" },
    { "src": "/features", "dest": "/frontend/features.html" },
    { "src": "/features.html", "dest": "/frontend/features.html" },
    { "src": "/features/ai-builder", "dest": "/frontend/feature-ai-builder.html" },
    { "src": "/features/ai-builder.html", "dest": "/frontend/feature-ai-builder.html" },
    { "src": "/features/logic", "dest": "/frontend/feature-logic.html" },
    { "src": "/features/logic.html", "dest": "/frontend/feature-logic.html" },
    { "src": "/features/multi-step", "dest": "/frontend/feature-multi-step.html" },
    { "src": "/features/multi-step.html", "dest": "/frontend/feature-multi-step.html" },
    { "src": "/templates", "dest": "/frontend/templates.html" },
    { "src": "/templates.html", "dest": "/frontend/templates.html" },
    { "src": "/templates/contact-form", "dest": "/frontend/template-contact-form.html" },
    { "src": "/templates/contact-form.html", "dest": "/frontend/template-contact-form.html" },
    { "src": "/templates/client-intake", "dest": "/frontend/template-client-intake.html" },
    { "src": "/templates/client-intake.html", "dest": "/frontend/template-client-intake.html" },
    { "src": "/templates/lead-capture", "dest": "/frontend/template-lead-capture.html" },
    { "src": "/templates/lead-capture.html", "dest": "/frontend/template-lead-capture.html" },
    { "src": "/templates/job-application", "dest": "/frontend/template-job-application.html" },
    { "src": "/templates/job-application.html", "dest": "/frontend/template-job-application.html" },
    { "src": "/templates/nps-survey", "dest": "/frontend/template-nps-survey.html" },
    { "src": "/templates/nps-survey.html", "dest": "/frontend/template-nps-survey.html" },
    { "src": "/templates/feedback", "dest": "/frontend/template-feedback.html" },
    { "src": "/templates/feedback.html", "dest": "/frontend/template-feedback.html" },
    { "src": "/templates/market-research", "dest": "/frontend/template-market-research.html" },
    { "src": "/templates/market-research.html", "dest": "/frontend/template-market-research.html" },
    { "src": "/integrations", "dest": "/frontend/integrations.html" },
    { "src": "/integrations.html", "dest": "/frontend/integrations.html" },
    { "src": "/use-cases/lead-generation", "dest": "/frontend/use-case-lead-generation.html" },
    { "src": "/use-cases/lead-generation.html", "dest": "/frontend/use-case-lead-generation.html" },
    { "src": "/use-cases/startups", "dest": "/frontend/use-case-startups.html" },
    { "src": "/use-cases/startups.html", "dest": "/frontend/use-case-startups.html" },
    { "src": "/use-cases/agencies", "dest": "/frontend/use-case-agencies.html" },
    { "src": "/use-cases/agencies.html", "dest": "/frontend/use-case-agencies.html" },
    { "src": "/use-cases/saas", "dest": "/frontend/use-case-saas.html" },
    { "src": "/use-cases/saas.html", "dest": "/frontend/use-case-saas.html" },
    { "src": "/pricing", "dest": "/frontend/pricing.html" },
    { "src": "/pricing.html", "dest": "/frontend/pricing.html" },
    { "src": "/", "dest": "/frontend/marketing.html" },
    { "src": "/marketing", "dest": "/frontend/marketing.html" },
    { "src": "/marketing.html", "dest": "/frontend/marketing.html" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
